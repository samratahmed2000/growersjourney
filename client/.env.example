# Growers Journy — frontend environment template
#
# Copy this file to `client/.env.local` and adjust if needed.
#
# IMPORTANT: this variable is deliberately NOT prefixed with NEXT_PUBLIC_.
#   - NEXT_PUBLIC_* values are embedded in the browser bundle and are public.
#   - API_BASE_URL is read only on the server (see src/lib/api/client.ts),
#     so the backend address stays out of browser code.
#   - Never put a database URL, API key, or other secret in a NEXT_PUBLIC_* value.

# Base URL of the Express API, including the /api/v1 version prefix.
API_BASE_URL=http://localhost:5000/api/v1

# Public base URL of this website, used for canonical links, Open Graph tags,
# robots.txt, and sitemap.xml. It is intentionally public (NEXT_PUBLIC_*) and
# must contain no secrets — it is the address a visitor can type.
# In development the app falls back to http://localhost:3000 when it is unset,
# and it also falls back if the value is not a valid URL, so a typo cannot crash
# the build. Set this to the real domain before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
