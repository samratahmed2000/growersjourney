# Growers Journy — frontend environment template
#
# Copy this file to `client/.env.local` and adjust if needed.
#
# IMPORTANT: this variable is deliberately NOT prefixed with NEXT_PUBLIC_.
#   - NEXT_PUBLIC_* values are embedded in the browser bundle and are public.
#   - API_BASE_URL is read only on the server (see src/lib/api/client.ts),
#     so the backend address stays out of browser code.
#   - Never put a database URL, API key, or other secret in a NEXT_PUBLIC_* value.

# Base URL of the Express API, including the /api/v1 version prefix.
#
# Read only on the server. Used by Server Components for the dev health page and
# the protected-area session check (`${API_BASE_URL}/auth/me`). next.config.ts
# also derives the API origin from it for the same-origin `/api/auth/*` rewrite.
#
# There is deliberately NO NEXT_PUBLIC_* auth URL: the login form posts to the
# relative path `/api/auth/sign-in/email` on this site, and the rewrite forwards
# it to Express. No auth secret or token is ever placed in frontend code.
API_BASE_URL=http://localhost:5000/api/v1

# Public base URL of the SAME Express API, used by the contact form in the
# browser. It must be reachable by visitors, so it is deliberately public and
# contains no credentials — never put a secret behind NEXT_PUBLIC_*.
#
# Why a second variable: API_BASE_URL above is server-only, but the contact form
# runs in the browser and cannot read it. This value is inlined at BUILD time,
# so set it before `npm run build`; changing it later requires a rebuild.
# It must match an origin allowed by the backend's FRONTEND_URL CORS setting
# (the website's origin, not the API's).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Public base URL of this website, used for canonical links, Open Graph tags,
# robots.txt, and sitemap.xml. It is intentionally public (NEXT_PUBLIC_*) and
# must contain no secrets — it is the address a visitor can type.
# In development the app falls back to http://localhost:3000 when it is unset,
# and it also falls back if the value is not a valid URL, so a typo cannot crash
# the build. Set this to the real domain before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
