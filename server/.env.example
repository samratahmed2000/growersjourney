# Growers Journy — backend environment template
#
# Copy this file to `server/.env` and fill in real values locally.
# NEVER commit the real `server/.env` file.
#
# Every variable below is server-only. None of them may be exposed to the
# frontend, and none may be prefixed with NEXT_PUBLIC_.

# development | production
NODE_ENV=development

# Port the Express API listens on.
PORT=5000

# MongoDB Atlas connection string. REQUIRED — the server exits at startup if it
# is missing or malformed.
#
# Notes:
# - Include the database name before the "?" parameters. Mongoose refuses to
#   connect without one, and omitting it silently falls back to a "test"
#   database.
# - Replace USER and PASSWORD with a LEAST-PRIVILEGE database user (readWrite on
#   this database only — never an administrative account).
# - URL-encode special characters in the password (for example @ becomes %40).
# - Keep separate connection strings (and databases) for development and
#   production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/growers_journy?retryWrites=true&w=majority

# Optional. Whether Better Auth's MongoDB adapter may use transactions.
#
# Default: true. MongoDB Atlas runs as a replica set and supports transactions.
# A standalone local `mongod` does NOT, so set MONGODB_TRANSACTIONS=false only in
# that case. Leaving it true against a standalone server makes authentication
# writes fail.
MONGODB_TRANSACTIONS=true

# The frontend origin(s) allowed by CORS and by Better Auth.
# Use a comma-separated list if more origins are needed, e.g.
# FRONTEND_URL=http://localhost:3000,https://growersjourny.com
# Only exact origins belong here (scheme + host + port), never "*".
FRONTEND_URL=http://localhost:3000

# Better Auth signing secret. REQUIRED, at least 32 characters.
#
# NEVER commit this value, log it, or expose it to the frontend. Generate a
# strong random value once and keep it stable (changing it invalidates every
# session):
#
#   openssl rand -base64 32
#
# Use a DIFFERENT secret for development and production.
BETTER_AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters

# Better Auth public base URL. REQUIRED.
#
# This is the PUBLIC FRONTEND ORIGIN, not the API port. The browser calls
# /api/auth/* on the Next.js site, and next.config.ts rewrites that path to this
# Express server. Better Auth uses this value for links and to decide whether
# session cookies need the Secure attribute.
#
# Development:  http://localhost:3000
# Production:   https://growersjourny.com   (https:// is required)
BETTER_AUTH_URL=http://localhost:3000

# Optional. How many reverse-proxy hops sit between the internet and this API.
#
# Leave it as `false` when the API is reached directly (including local
# development). Set it to a small number when a known proxy or platform edge
# forwards requests to this server — for example TRUST_PROXY=1.
#
# Why it matters: the public inquiry endpoint and Better Auth rate-limit by
# client IP. Too low, and every visitor shares one bucket; too high (or `true`),
# and a caller can forge X-Forwarded-For to get a fresh bucket on every request.
# `true` is deliberately rejected. Use the number of hops you actually control.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Administrator provisioning (used only by `npm run create-admin`)
# ---------------------------------------------------------------------------
# These are NOT runtime settings. Set them for the single provisioning command,
# then remove them from your shell. The script creates an ADMIN account, hashes
# the password with Better Auth's scrypt implementation, and never prints the
# password.
#
#   ADMIN_EMAIL=you@example.com
#   ADMIN_NAME=Your Name
#   ADMIN_PASSWORD=a-long-unique-password-at-least-12-characters
#
# A second ADMIN is refused unless you also set ALLOW_ADDITIONAL_ADMIN=true for
# that command. There is no public sign-up endpoint and no way for a user to
# assign themselves a role.
