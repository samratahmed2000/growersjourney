# Growers Journy — backend environment template
#
# Copy this file to `server/.env` and fill in real values locally.
# NEVER commit the real `server/.env` file.
#
# Every variable below is server-only. None of them may be exposed to the
# frontend, and none may be prefixed with NEXT_PUBLIC_.

# development | production
NODE_ENV=development

# Port the Express API listens on.
PORT=5000

# MongoDB Atlas connection string. REQUIRED — the server exits at startup if it
# is missing or malformed.
#
# Notes:
# - Include the database name before the "?" parameters. Mongoose refuses to
#   connect without one, and omitting it silently falls back to a "test"
#   database.
# - Replace USER and PASSWORD with a LEAST-PRIVILEGE database user (readWrite on
#   this database only — never an administrative account).
# - URL-encode special characters in the password (for example @ becomes %40).
# - Keep separate connection strings (and databases) for development and
#   production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/growers_journy?retryWrites=true&w=majority

# The frontend origin(s) allowed by CORS.
# Use a comma-separated list if more origins are needed, e.g.
# FRONTEND_URL=http://localhost:3000,https://growersjourny.com
FRONTEND_URL=http://localhost:3000

# Optional. How many reverse-proxy hops sit between the internet and this API.
#
# Leave it as `false` when the API is reached directly (including local
# development). Set it to a small number when a known proxy or platform edge
# forwards requests to this server — for example TRUST_PROXY=1.
#
# Why it matters: the public inquiry endpoint rate-limits by client IP. Too low,
# and every visitor shares one bucket; too high (or `true`), and a caller can
# forge X-Forwarded-For to get a fresh bucket on every request. `true` is
# deliberately rejected. Use the number of hops you actually control.
TRUST_PROXY=false
