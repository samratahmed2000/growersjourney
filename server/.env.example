# Growers Journy — backend environment template
#
# Copy this file to `server/.env` and fill in real values locally.
# NEVER commit the real `server/.env` file.
#
# Variable names below match the ACTUAL code in `server/index.js`
# (which reads DB_USER / DB_PASS), not the older `MONGODB_URI` wording
# used in some documents under `docs/`.

# development | production
NODE_ENV=development

# Port the Express API listens on.
PORT=5000

# MongoDB Atlas credentials.
DB_USER=your-atlas-database-user
DB_PASS=your-atlas-database-password

# The single frontend origin allowed by CORS.
# Use a comma-separated list if more origins are needed, e.g.
# FRONTEND_URL=http://localhost:3000,https://growersjourny.com
FRONTEND_URL=http://localhost:3000
